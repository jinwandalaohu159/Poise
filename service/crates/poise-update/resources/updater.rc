#pragma code_page(65001)
#include <winver.h>

1 ICON "../../../../app/Poise.App/Assets/Poise.ico"
1 24 "updater.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION POISE_VERSION
PRODUCTVERSION POISE_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Poise 更新"
            VALUE "ProductName", "Poise"
            VALUE "FileVersion", POISE_VERSION_TEXT
            VALUE "ProductVersion", POISE_VERSION_TEXT
            VALUE "InternalName", "poise-updater"
            VALUE "OriginalFilename", "poise-updater.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
