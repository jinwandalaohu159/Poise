<Project Sdk="Microsoft.NET.Sdk">
  <!-- 界面无关的逻辑：与服务通信、本地化、状态换算、设置、日志。不依赖 WinUI，可以直接单元测试。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Poise.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings\*.json" WithCulture="false"
                      LogicalName="Poise.Core.Localization.Strings.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- 开机启动任务的定义：放在安装目录根下，界面和安装脚本共用。 -->
    <None Include="Settings\AutostartTask.xml" Link="AutostartTask.xml"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Poise.Core.Tests" />
  </ItemGroup>
</Project>
