<Window
    x:Class="Poise.App.UI.Windows.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Poise.App.UI.Controls"
    xmlns:l="using:Poise.App.UI.Localization">

    <!-- 紧凑排列：指标 / 模式 / 一键清理 + 打开主窗口；清理结果只在有内容时占一行 -->
    <Grid x:Name="Root" Padding="14" RowSpacing="12" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 四个指标（紧凑：不显示进度条），与主页一致 -->
        <c:MetricStrip x:Name="Metrics" IsCompact="True" />

        <c:ModeSelector x:Name="Modes" Grid.Row="1" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:ActionButton x:Name="CleanButton" HorizontalAlignment="Stretch" />
            <Button x:Name="OpenButton" Grid.Column="1" MinHeight="36" Padding="10,0" Click="OnOpenMain">
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8A7;" FontSize="16" />
            </Button>
        </Grid>

        <TextBlock x:Name="ResultText" Grid.Row="3" Visibility="Collapsed" Margin="2,0"
                   Style="{StaticResource CaptionSecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </Grid>
</Window>
