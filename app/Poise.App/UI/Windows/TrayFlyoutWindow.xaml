<Window
    x:Class="Poise.App.UI.Windows.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Poise.App.UI.Controls"
    xmlns:l="using:Poise.App.UI.Localization">

    <Grid x:Name="Root" Padding="16" RowSpacing="16" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 状态 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:StatusDot x:Name="Dot" VerticalAlignment="Top" Margin="0,10,0,0" />
            <StackPanel x:Name="StatusText" Grid.Column="1">
                <TextBlock x:Name="StatusTitle" Style="{StaticResource PageTitleTextStyle}" FontSize="20" />
                <TextBlock x:Name="StatusDescription" Style="{StaticResource CaptionSecondaryTextStyle}" />
            </StackPanel>
        </Grid>

        <c:ModeSelector x:Name="Modes" Grid.Row="1" />

        <c:ActionButton x:Name="CleanButton" Grid.Row="2" HorizontalAlignment="Stretch" />

        <Grid Grid.Row="3">
            <TextBlock x:Name="ResultText" Style="{StaticResource CaptionSecondaryTextStyle}"
                       VerticalAlignment="Center" Margin="0,0,96,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <HyperlinkButton HorizontalAlignment="Right" Content="{l:L Key=tray.open}" Click="OnOpenMain" />
        </Grid>
    </Grid>
</Window>
