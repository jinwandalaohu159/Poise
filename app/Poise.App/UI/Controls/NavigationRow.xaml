<UserControl
    x:Class="Poise.App.UI.Controls.NavigationRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button x:Name="Button" Style="{StaticResource SettingsRowButtonStyle}" Click="OnClick">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="Icon" FontFamily="{StaticResource IconFont}" FontSize="20" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" />
                <TextBlock x:Name="DescriptionText" Style="{StaticResource CaptionSecondaryTextStyle}" />
            </StackPanel>
            <FontIcon Grid.Column="2" FontFamily="{StaticResource IconFont}" Glyph="&#xE76C;" FontSize="12" />
        </Grid>
    </Button>
</UserControl>
