<UserControl
    x:Class="Poise.App.UI.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="8" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton"
                Width="36" Height="36" Padding="0"
                VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0"
                Click="OnBack">
            <FontIcon FontFamily="{StaticResource IconFont}" FontSize="14" Glyph="&#xE72B;" />
        </Button>
        <BreadcrumbBar x:Name="Crumbs" Grid.Column="1" VerticalAlignment="Center" ItemClicked="OnCrumbClicked" />
    </Grid>
</UserControl>
