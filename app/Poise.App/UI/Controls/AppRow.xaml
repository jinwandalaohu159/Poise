<UserControl
    x:Class="Poise.App.UI.Controls.AppRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Poise.App.UI.Controls"
    xmlns:l="using:Poise.App.UI.Localization"
    xmlns:vm="using:Poise.App.UI.ViewModels">

    <!-- 一个程序：程序行 + 展开后的进程行，放在同一张卡片里 -->
    <Border Style="{StaticResource CardStyle}" Padding="0">
        <StackPanel>
            <Grid MinHeight="64" Padding="{StaticResource AppsRowPadding}" ColumnSpacing="{StaticResource AppsColumnSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource AppsChevronColumn}" />
                    <ColumnDefinition Width="{StaticResource AppsIconColumn}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource AppsCpuColumn}" />
                    <ColumnDefinition Width="{StaticResource AppsMemoryColumn}" />
                    <ColumnDefinition Width="{StaticResource AppsPreferenceColumn}" />
                </Grid.ColumnDefinitions>
                <Button Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" Visibility="{x:Bind Item.ChevronVisibility, Mode=OneWay}"
                        Click="OnToggle" AutomationProperties.Name="{x:Bind Item.ExpandLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Item.ExpandLabel, Mode=OneWay}">
                    <FontIcon x:Name="Chevron" FontFamily="{StaticResource IconFont}" Glyph="&#xE76C;" FontSize="10" CenterPoint="5,5,0" />
                </Button>
                <!-- 图标只为显示出来的行读取（列表虚拟化），见 ProgramIcon -->
                <c:ProgramIcon Grid.Column="1" Path="{x:Bind Item.Path, Mode=OneWay}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Item.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <!-- 正在运行：调度状态（多个进程时带进程数）；没有运行：路径 -->
                    <TextBlock Text="{x:Bind Item.Detail, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{x:Bind Item.Cpu, Mode=OneWay}" Style="{StaticResource TableNumberTextStyle}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{x:Bind Item.Memory, Mode=OneWay}" Style="{StaticResource TableNumberTextStyle}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <!-- 选项顺序与 AppPreference 一致；写在 XAML 里，保证先有选项再绑定选中项。系统一栏只供查看，
                     不创建这一项（x:Load）：几百行的列表里每行一个下拉框也是不小的开销。 -->
                <ComboBox x:Name="Preference" Grid.Column="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="{StaticResource AppsPreferenceGap}"
                          x:Load="{x:Bind Item.CanSetPreference, Mode=OneWay}"
                          SelectedIndex="{x:Bind Item.PreferenceIndex, Mode=TwoWay}"
                          DropDownOpened="OnDropDownOpened" DropDownClosed="OnDropDownClosed">
                    <ComboBoxItem Content="{l:L Key=pref.auto}" />
                    <ComboBoxItem Content="{l:L Key=pref.always_fast}" />
                    <ComboBoxItem Content="{l:L Key=pref.background}" />
                    <ComboBoxItem Content="{l:L Key=pref.game}" />
                </ComboBox>
            </Grid>

            <!-- 展开后：各个进程（有自己窗口的另一个程序可以单独设置类别）。高度从 0 增长到内容高度，内容从上往下露出 -->
            <Grid x:Name="ProcessesHost" Visibility="Collapsed" SizeChanged="OnHostSizeChanged">
                <StackPanel x:Name="ProcessesContent" VerticalAlignment="Top" Padding="0,0,0,6">
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{x:Bind Item.Processes, Mode=OneWay}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessItem">
                                <Grid MinHeight="36" Padding="{StaticResource AppsRowPadding}" ColumnSpacing="{StaticResource AppsColumnSpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource AppsChevronColumn}" />
                                        <ColumnDefinition Width="{StaticResource AppsIconColumn}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource AppsCpuColumn}" />
                                        <ColumnDefinition Width="{StaticResource AppsMemoryColumn}" />
                                        <ColumnDefinition Width="{StaticResource AppsPreferenceColumn}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="2" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                                                   VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Cpu, Mode=OneWay}" Style="{StaticResource TableNumberTextStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Memory, Mode=OneWay}" Style="{StaticResource TableNumberTextStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ProcessPreference" Grid.Column="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="{StaticResource AppsPreferenceGap}"
                                              x:Load="{x:Bind CanSetPreference, Mode=OneWay}"
                                              SelectedIndex="{x:Bind PreferenceIndex, Mode=TwoWay}"
                                              DropDownOpened="OnDropDownOpened" DropDownClosed="OnDropDownClosed">
                                        <ComboBoxItem Content="{l:L Key=pref.auto}" />
                                        <ComboBoxItem Content="{l:L Key=pref.always_fast}" />
                                        <ComboBoxItem Content="{l:L Key=pref.background}" />
                                        <ComboBoxItem Content="{l:L Key=pref.game}" />
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
