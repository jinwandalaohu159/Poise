<UserControl
    x:Class="Poise.App.UI.Controls.ModeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <Grid x:Name="Card"
          MinHeight="96"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource CardCorner}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Card.Background" Value="Transparent" />
                        <Setter Target="Card.BorderBrush" Value="Transparent" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="TitleLabel.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="Desc.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Setter Target="Check.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SizeStates">
                <VisualState x:Name="Full" />
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="Desc.Visibility" Value="Collapsed" />
                        <Setter Target="Card.MinHeight" Value="72" />
                        <Setter Target="Body.Padding" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 悬停层：半透明叠加，选中与未选中时都适用 -->
        <Border x:Name="HoverLayer"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="{StaticResource CardCorner}"
                Opacity="0" />

        <Grid x:Name="Body" Padding="16">
        <StackPanel Spacing="4">
            <FontIcon x:Name="Icon"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,4"
                      FontFamily="{StaticResource IconFont}"
                      FontSize="24"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TitleLabel" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Desc"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap" />
        </StackPanel>

        <FontIcon x:Name="Check"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  FontFamily="{StaticResource IconFont}" FontSize="14"
                  Glyph="&#xE73E;"
                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                  Visibility="Collapsed" />

        <!-- 游戏时自动切到全力的标记 -->
        <Border x:Name="Badge"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Padding="6,1"
                Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                CornerRadius="8"
                Opacity="0">
            <TextBlock x:Name="BadgeText" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Border>
        </Grid>
    </Grid>
</UserControl>
