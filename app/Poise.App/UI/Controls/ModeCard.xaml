<UserControl
    x:Class="Poise.App.UI.Controls.ModeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <Grid x:Name="Card"
          MinHeight="96"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource CardCorner}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SizeStates">
                <VisualState x:Name="Full" />
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="Desc.Visibility" Value="Collapsed" />
                        <Setter Target="Badge.Visibility" Value="Collapsed" />
                        <Setter Target="Card.MinHeight" Value="64" />
                        <Setter Target="Body.Padding" Value="6,10" />
                        <Setter Target="Icon.FontSize" Value="20" />
                        <Setter Target="TitleLabel.FontSize" Value="13" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 悬停与按下：半透明叠加（按下时更浅），不改变卡片尺寸 -->
        <Border x:Name="HoverLayer"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="{StaticResource CardCorner}"
                Opacity="0" />

        <!-- 图标、名称、说明居中；选中只由 ModeSelector 的描边框表示，卡片上不加勾 -->
        <Grid x:Name="Body" Padding="12,16">
            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon x:Name="Icon"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,4"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="24"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="TitleLabel" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Desc"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- "使用中"：实际使用的模式与所选不同时（游戏时、过热降级）标在右上角 -->
        <Border x:Name="Badge"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,8,8,0"
                Padding="6,1"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="8"
                Opacity="0">
            <TextBlock x:Name="BadgeText" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>
    </Grid>
</UserControl>
