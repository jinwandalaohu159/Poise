<UserControl
    x:Class="Poise.App.UI.Controls.ProgramIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="20" Height="20">

    <!-- 程序图标；取不到时显示通用图标 -->
    <Grid>
        <Image x:Name="Picture" />
        <FontIcon x:Name="Fallback" FontFamily="{StaticResource IconFont}" Glyph="&#xE7C4;" FontSize="16"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
