<UserControl
    x:Class="Poise.App.UI.Controls.StatusDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="8" Height="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LevelStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.25" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Good" />
                <VisualState x:Name="Notice">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Bad">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Off">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource TextFillColorDisabledBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Ellipse x:Name="Dot" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
    </Grid>
</UserControl>
