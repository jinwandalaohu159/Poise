<UserControl
    x:Class="Poise.App.UI.Controls.LogoMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="16" Height="16">
    <!-- 占位标志：圆环 + 中心点。正式 Logo 由用户提供后替换。 -->
    <Viewbox>
        <Grid Width="16" Height="16">
            <Ellipse Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Margin="1" />
            <Ellipse Width="5" Height="5" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        </Grid>
    </Viewbox>
</UserControl>
