<UserControl
    x:Class="Poise.App.UI.Controls.ModeSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 模式卡片由代码按可用模式生成（四张或五张，等宽）；选中框放在选中卡片所在的列（随列宽自动对齐），画在卡片上方 -->
    <Grid x:Name="Root" ColumnSpacing="8">
        <Grid x:Name="Pill"
              IsHitTestVisible="False"
              Canvas.ZIndex="1">
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{StaticResource CardCorner}"
                    Opacity="0.08" />
            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource CardCorner}" />
        </Grid>
    </Grid>
</UserControl>
