<UserControl
    x:Class="Poise.App.UI.Controls.ModeSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Poise.App.UI.Controls">

    <Grid x:Name="Root" ColumnSpacing="8" SizeChanged="OnSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 选中的强调色底块：在三张卡片之间滑动 -->
        <Border x:Name="Pill"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="{StaticResource CardCorner}" />

        <c:ModeCard x:Name="QuietCard" Grid.Column="0" Glyph="&#xE708;" />
        <c:ModeCard x:Name="BalancedCard" Grid.Column="1" Glyph="&#xE9E9;" />
        <c:ModeCard x:Name="FullCard" Grid.Column="2" Glyph="&#xE945;" />
    </Grid>
</UserControl>
