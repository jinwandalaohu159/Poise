<UserControl
    x:Class="Poise.App.UI.Controls.SortHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- 取色用（不显示）：ThemeResource 跟随控件自身的深浅色 -->
        <Border x:Name="ActiveBrush" Visibility="Collapsed" Background="{ThemeResource TextFillColorPrimaryBrush}" />
        <Border x:Name="InactiveBrush" Visibility="Collapsed" Background="{ThemeResource TextFillColorTertiaryBrush}" />

        <!-- 可点的列名：悬停、按下有底色反馈；当前排序的列文字加深并显示箭头，方向切换时箭头转半圈 -->
        <Button x:Name="Root" Click="OnClick" Padding="6,3" MinHeight="0" MinWidth="0" CornerRadius="4"
                Background="Transparent" BorderThickness="0">
            <Button.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Button.Resources>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <!-- 数值列的箭头在文字左边（列右对齐），名称列在右边 -->
                <FontIcon x:Name="LeadingArrow" FontFamily="{StaticResource IconFont}" Glyph="&#xE70E;" FontSize="9"
                          CenterPoint="4.5,4.5,0" VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Style="{StaticResource ColumnHeaderTextStyle}" VerticalAlignment="Center" />
                <FontIcon x:Name="TrailingArrow" FontFamily="{StaticResource IconFont}" Glyph="&#xE70E;" FontSize="9"
                          CenterPoint="4.5,4.5,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
