<UserControl
    x:Class="Poise.App.UI.Controls.MetricTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel x:Name="Root" MinWidth="64" Spacing="0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LevelStates">
                <VisualState x:Name="Good" />
                <VisualState x:Name="Notice">
                    <VisualState.Setters>
                        <Setter Target="ValueText.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Bad">
                    <VisualState.Setters>
                        <Setter Target="ValueText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock x:Name="ValueText" Style="{StaticResource MetricValueTextStyle}" Text="—" />
        <TextBlock x:Name="LabelText" Style="{StaticResource CaptionSecondaryTextStyle}" />
    </StackPanel>
</UserControl>
