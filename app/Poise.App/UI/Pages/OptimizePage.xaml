<Page
    x:Class="Poise.App.UI.Pages.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Poise.App.UI.Controls"
    xmlns:l="using:Poise.App.UI.Localization"
    xmlns:p="using:Poise.App.UI.Pages"
    xmlns:vm="using:Poise.App.UI.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <!-- 固定项：状态 + 优化/还原按钮 -->
        <DataTemplate x:Key="StaticRowTemplate" x:DataType="vm:OptimizationRow">
            <Grid Style="{StaticResource SettingsRowStyle}" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 名称 + 圆圈问号（说明与生效时机在提示里） -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <c:InfoTip Text="{x:Bind Help}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing Width="14" Height="14" IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" VerticalAlignment="Center"
                               Style="{StaticResource CaptionSecondaryTextStyle}" />
                </StackPanel>
                <Button Grid.Column="2" MinWidth="72" VerticalAlignment="Center"
                        Content="{x:Bind ActionText, Mode=OneWay}"
                        Visibility="{x:Bind HasAction, Mode=OneWay}"
                        IsEnabled="{x:Bind CanChange, Mode=OneWay}"
                        Click="{x:Bind Invoke}" />
            </Grid>
        </DataTemplate>

        <!-- 逐个开关的项：开 = 保持原样，关 = 禁用 -->
        <DataTemplate x:Key="ToggleRowTemplate" x:DataType="vm:OptimizationRow">
            <Grid Style="{StaticResource SettingsRowStyle}" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <c:InfoTip Text="{x:Bind Help}" />
                        <Border Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{x:Bind SlowHint}">
                            <TextBlock Text="{l:L Key=optimize.slow}" FontSize="11"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" Style="{StaticResource TrailingToggleSwitchStyle}"
                              IsOn="{x:Bind IsOn, Mode=TwoWay}"
                              IsEnabled="{x:Bind CanChange, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <p:OptimizationRowTemplateSelector x:Key="RowSelector"
                                           Static="{StaticResource StaticRowTemplate}"
                                           Toggle="{StaticResource ToggleRowTemplate}" />
    </Page.Resources>

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader x:Name="Header" />

        <!-- 摘要：推荐项的优化进度、一键优化、全部还原 -->
        <Border Grid.Row="1" Style="{StaticResource LargeCardStyle}">
            <Grid ColumnSpacing="32" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="SummaryText" Style="{StaticResource PageTitleTextStyle}" FontSize="20" Text="{l:L Key=home.optimize.loading}" />
                        <c:InfoTip Text="{l:L Key=optimize.summary.desc}" />
                    </StackPanel>
                    <!-- 进度条与标题左对齐，最宽 360 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="360" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:MeterBar x:Name="SummaryBar" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RevertAllButton" MinHeight="36" Content="{l:L Key=common.revert_all}" Click="OnRevertAll" />
                    <c:ActionButton x:Name="OptimizeButton" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="8">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" Margin="0,20,-24,0" Padding="0,0,24,0">
            <StackPanel>
                <ProgressRing IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}" Visibility="{x:Bind Vm.IsLoading, Mode=OneWay}"
                              HorizontalAlignment="Left" Width="24" Height="24" />
                <ItemsControl ItemsSource="{x:Bind Vm.Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptimizationSection">
                            <StackPanel Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="1,0,0,8">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionTextStyle}" Margin="0" />
                                    <c:InfoTip Text="{x:Bind HintText}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplateSelector="{StaticResource RowSelector}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <c:ResultToast x:Name="Result" Grid.RowSpan="4" />
    </Grid>
</Page>
