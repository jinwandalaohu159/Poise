<Page
    x:Class="Poise.App.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Poise.App.UI.Controls"
    xmlns:l="using:Poise.App.UI.Localization"
    xmlns:p="using:Poise.Core.Presentation"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="{StaticResource CardGap}">
            <c:PageHeader x:Name="Header" />

            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xF2B7;" FontSize="20" />
                <TextBlock Grid.Column="1" Text="{l:L Key=settings.language}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" MinWidth="148" VerticalAlignment="Center"
                          ItemsSource="{x:Bind Vm.LanguageOptions}"
                          SelectedIndex="{x:Bind Vm.LanguageIndex, Mode=TwoWay}" />
            </Grid>

            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE790;" FontSize="20" />
                <TextBlock Grid.Column="1" Text="{l:L Key=settings.theme}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" MinWidth="148" VerticalAlignment="Center"
                          ItemsSource="{x:Bind Vm.ThemeOptions}"
                          SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}" />
            </Grid>

            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE7E8;" FontSize="20" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:L Key=settings.autostart}" />
                    <TextBlock Text="{l:L Key=settings.autostart.desc}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" Style="{StaticResource TrailingToggleSwitchStyle}"
                              IsEnabled="{x:Bind Vm.AutostartAvailable}"
                              IsOn="{x:Bind Vm.AutostartEnabled, Mode=TwoWay}" />
            </Grid>

            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xEA8F;" FontSize="20" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:L Key=settings.tray_alert}" />
                    <TextBlock Text="{l:L Key=settings.tray_alert.desc}" Style="{StaticResource CaptionSecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" Style="{StaticResource TrailingToggleSwitchStyle}"
                              IsOn="{x:Bind Vm.TrayAlertEnabled, Mode=TwoWay}" />
            </Grid>

            <TextBlock Text="{l:L Key=settings.hardware}" Style="{StaticResource SectionTextStyle}" Margin="1,20,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <ItemsControl ItemsSource="{x:Bind Vm.Hardware}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="p:HardwareRow">
                            <!-- 名称在左，数值右对齐 -->
                            <Grid ColumnSpacing="24" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionSecondaryTextStyle}"
                                           VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource BodyTextStyle}"
                                           HorizontalAlignment="Right" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="{l:L Key=settings.update}" Style="{StaticResource SectionTextStyle}" Margin="1,20,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <!-- 状态与说明在左，操作在右 -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Vm.UpdateStatus, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                        <ProgressBar Maximum="100" Value="{x:Bind Vm.DownloadPercent, Mode=OneWay}"
                                     Visibility="{x:Bind Vm.IsDownloading, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Vm.UpdateNotes, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}"
                                   TextWrapping="Wrap" Visibility="{x:Bind Vm.HasUpdateNotes, Mode=OneWay}" />
                        <HyperlinkButton Content="{l:L Key=settings.update.notes}" Style="{StaticResource DetailsLinkStyle}" Padding="0,2"
                                         NavigateUri="{x:Bind Vm.ReleasePage, Mode=OneWay}"
                                         Visibility="{x:Bind Vm.HasReleasePage, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="{l:L Key=update.check}" Style="{StaticResource ActionButtonStyle}"
                                IsEnabled="{x:Bind Vm.CanCheckUpdate, Mode=OneWay}" Click="{x:Bind Vm.CheckForUpdates}" />
                        <Button Content="{l:L Key=update.install}" Style="{StaticResource AccentActionButtonStyle}"
                                IsEnabled="{x:Bind Vm.CanInstallUpdate, Mode=OneWay}" Click="{x:Bind Vm.InstallUpdate}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{l:L Key=settings.about}" Style="{StaticResource SectionTextStyle}" Margin="1,20,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                        <c:LogoMark Width="32" Height="32" />
                        <TextBlock Text="{x:Bind Vm.VersionText}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{l:L Key=settings.service}" Style="{StaticResource CaptionSecondaryTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Vm.ServiceText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Right" TextAlignment="Right" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
